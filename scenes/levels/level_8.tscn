point_persons = [NodePath("PanelContainer/HBoxContainer/VBoxContainer/GridContainer/Person4"), NodePath("PanelContainer/HBoxContainer/VBoxContainer/GridContainer/Person7"), NodePath("PanelContainer/HBoxContainer/VBoxContainer/GridContainer/Person9")]
teach_text = "If the number of people accusing a set of people is greater than the number of liars, then at least one of these sets must contain a liar. 
If there are more people with the same role than there are remaining liars, then those people are innocent."
bottom_out_text = "This is the final boss. B3 clears B2 so they have the same role, and same for C2 with C3. Then, we can see that A2, A3 and C3 all accuse a set of people of containing a liar. This means the union of these sets must contain one, because at least one of them must be telling the truth. So, at most one liar can be outside of this set. Since C2 and C3 are not included in the set and have the same role, they must be innocent. So, at least one witch lies, and at most one liar is not a witch. Since B2 and B3 have the same role, they must be telling the truth as well. Looking at A3, only one of their neighbors has their role unknown, A2. So either A3 tells the truth and A2 lies, or the opposite. Similarly, the only unknown role from the middle row is A2, so A1 and A2 are opposite. Since A1 is opposite to A2 who is opposite to A3, A1 and A3 have the same role. However, we know that there is a lying witch, and neither A1 nor A3 are witches, so they tell the truth. This gives us A2 as liar, so all of their neighors tell the truth, and the only remaining spot for the second liar is C1."

